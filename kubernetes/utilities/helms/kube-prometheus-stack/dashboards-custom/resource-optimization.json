      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(\n  (\n    sum by (namespace,pod,container) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\"}[5m]))\n    /\n    sum by (namespace,pod,container) (kube_pod_container_resource_requests{resource=\"cpu\",namespace=~\"$namespace\",pod=~\"$pod\"})\n  )[1h:5m]\n) > 0",
          "legendFormat": "{{namespace}}/{{pod}}/{{container}}",
          "refId": "A"
        }
      ],
      "title": "CPU Request Utilization (1h avg)",
      "description": "Average utilization of CPU requests over the last hour. Low values indicate over-provisioning",
      "type": "bargauge"
    },
