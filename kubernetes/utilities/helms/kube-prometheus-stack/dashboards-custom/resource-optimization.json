    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 36 },
      "id": 102,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false },
        "content": "## Resource Recommendations\nSuggested values based on actual usage patterns",
        "mode": "markdown"
      },
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Current Request" },
            "properties": [{ "id": "unit", "value": "short" }]
          },
          {
            "matcher": { "id": "byName", "options": "P95 Usage" },
            "properties": [{ "id": "unit", "value": "short" }]
          },
          {
            "matcher": { "id": "byName", "options": "Recommended Request" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Savings %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0 }, { "color": "green", "value": 20 }] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 38 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Savings %" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "# Current CPU Request\nsum by (namespace,pod,container) (kube_pod_container_resource_requests{resource=\"cpu\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Current Request",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "# P95 CPU Usage\nquantile by (namespace,pod,container) (0.95,\n  sum by (namespace,pod,container) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\"}[5m]))\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "P95 Usage",
          "refId": "B"
        }
      ],
      "title": "CPU Request Recommendations",
      "description": "Recommended CPU requests based on P95 usage + 20% buffer",
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "container" } },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "Time 1": true, "Time 2": true },
          "renameByName": { "Value #A": "Current Request", "Value #B": "P95 Usage", "namespace 1": "namespace", "pod 1": "pod" }
        }},
        { "id": "calculateField", "options": { "alias": "Recommended Request", "formula": "$B * 1.2", "mode": "formula" } },
        { "id": "calculateField", "options": { "alias": "Savings %", "formula": "(($A - $B * 1.2) / $A) * 100", "mode": "formula" } },
        { "id": "filterByValue", "options": { "filters": [{ "config": { "id": "greater", "options": { "value": 0 } }, "fieldName": "Current Request" }], "match": "all", "type": "include" } }
      ],
      "type": "table"
    },
